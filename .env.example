# App
APP_NAME="In & Out Laundry AI Agent"
APP_URL="https://www.inandoutuae.com"
NODE_ENV="production"
AI_AGENT_API_KEY=""
DEFAULT_TIMEZONE="Asia/Dubai"

# Internal service API used by n8n workflows.
# The workflow generator accepts this value with or without the trailing /api/v1.
SERVICE_API_BASE_URL="https://service.inandoutuae.com/api/v1"
SERVICE_API_TOKEN=""

# OpenAI
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4.1-mini"
OPENAI_CHAT_MODEL="gpt-4.1-mini"
OPENAI_TRANSCRIPTION_MODEL="gpt-4o-mini-transcribe"
AI_AGENT_AUTO_CREATE_PICKUPS="true"
CONVERSATION_SUMMARY_MESSAGE_THRESHOLD="20"

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""
WHATSAPP_VERIFY_TOKEN=""
