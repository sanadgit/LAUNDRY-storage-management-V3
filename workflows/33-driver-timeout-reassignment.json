          },
          "conditions": [
            {
              "id": "pending-or-assigned",
              "leftValue": "={{[\"PENDING\",\"ASSIGNED\"].includes(String($json.body?.data?.status || $json.status || \"\").toUpperCase())}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
