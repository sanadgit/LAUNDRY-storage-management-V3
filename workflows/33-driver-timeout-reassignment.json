        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { status: 'TIMED_OUT', reason: $json.reason || 'Driver acceptance timeout', previousDriverId: $json.body?.data?.driverId || null, correlationId: $json.correlationId || $('Workflow Input').first().json.correlationId } }}",
        "options": {
          "response": {
            "response": {
