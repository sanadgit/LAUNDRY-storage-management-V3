        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + ($vars.N8N_API_KEY || '')}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
