          }
        ]
      ]
    },
    "Validate Media Download URL": {
      "main": [
        [
          {
            "node": "Download Audio",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Audio Error Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Download Audio": {
      "main": [
        [
          {
            "node": "Validate Audio Type",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate Audio Type": {
      "main": [
        [
          {
            "node": "Prepare Binary Audio",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Audio Error Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Binary Audio": {
      "main": [
        [
          {
