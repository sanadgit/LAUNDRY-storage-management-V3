    {
      "id": "critical-complaint",
      "name": "Critical Complaint?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -240,
        20
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "critical",
              "leftValue": "={{[\"P1_CRITICAL\",\"P2_HIGH\"].includes($(\"Load Complaint\").first().json.body?.data?.priority || $(\"Workflow Input\").first().json.priority)}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
