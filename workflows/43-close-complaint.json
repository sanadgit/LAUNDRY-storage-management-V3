        "jsonBody": "={{ { actorId: $('Workflow Input').first().json.actorId || $('Workflow Input').first().json.managerId, actorRole: $('Workflow Input').first().json.actorRole || 'manager', requestedStatus: 'CLOSED', correlationId: $('Workflow Input').first().json.correlationId || $('Workflow Input').first().json.correlation_id } }}",
        "options": {
