        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { conversationId: $json.conversationId, customerId: $json.customerId || null, direction: 'inbound', senderType: 'customer', channel: 'whatsapp', body: $json.messageText || $json.customerMessage || $json.normalizedText || '', providerMessageId: $json.originalMessageId || $json.wamid || '', messageType: $json.messageType || 'text', correlationId: $json.correlationId, workflowExecutionId: $json.workflowExecutionId } }}",
        "options": {
          "response": {
