              "type": "string",
              "value": "={{String($json.body?.data?.status || $json.data?.status || $json.status || ($json.body?.data?.branchId ? \"MATCHED\" : \"UNKNOWN\")).toUpperCase()}}"
            },
            {
              "id": "normalizedArea",
              "name": "normalizedArea",
              "type": "string",
              "value": "={{$json.body?.data?.normalizedArea || $json.body?.data?.area || $json.normalizedAreaInput || $(\"Normalize Area Name\").first().json.normalizedAreaInput || \"\"}}"
            },
            {
              "id": "branchId",
              "name": "branchId",
              "type": "string",
              "value": "={{$json.body?.data?.branchId || $json.branchId || \"\"}}"
            },
            {
              "id": "branchName",
