              "id": "success",
              "name": "success",
              "type": "boolean",
              "value": "={{$json.statusCode ? ($json.statusCode >= 200 && $json.statusCode < 300 && $json.body?.ok !== false) : false}}"
            },
            {
              "id": "completed",
              "name": "completed",
              "type": "boolean",
              "value": "={{Boolean((($items(\"Mark Completed\", 0, 0)[0] || {}).json || {}).body?.ok)}}"
