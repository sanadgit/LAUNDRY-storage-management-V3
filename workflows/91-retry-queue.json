        "jsonBody": "={{ { operation: $json.operation, component: $json.component, payloadRef: $json.payloadRef || $json.payload_ref || null, safePayload: $json.safePayload || null, idempotencyKey: $json.idempotencyKey, attempt: $json.nextAttempt, correlationId: $json.correlationId } }}",
        "options": {
