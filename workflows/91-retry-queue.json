        "url": "={{($vars.SERVICE_API_BASE_URL || 'MISSING_SERVICE_API_BASE_URL').replace(/\\/$/, '').replace(/\\/api\\/v1$/i, '') + '/api/v1/retry-records/' + encodeURIComponent($('Calculate Backoff').first().json.retryRecordId || 'inline') + '/attempts'}}",
        "sendHeaders": true,
