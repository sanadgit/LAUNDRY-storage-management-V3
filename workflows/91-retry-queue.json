              "name": "correlationId",
              "type": "string",
              "value": "={{$(\"Calculate Backoff\").first().json.correlationId || $(\"Workflow Input\").first().json.correlationId}}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {
