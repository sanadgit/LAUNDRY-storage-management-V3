            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "duplicate-flag",
              "leftValue": "={{Boolean($json.duplicate_message || $json.data?.duplicate_message || $json.data?.duplicate || $json.agent?.duplicate_message)}}",
