URIComponent(normalizedPhone);\n  json.createConversationUrl = serviceApiBaseUrl + '/api/v1/ai/conversations';\n  json.createConversationBody = {\n    provider: 'whatsapp',\n    customerId: customerId || null,\n    normalizedPhone: normalizedPhone || null,\n    language: json.language || json.detectedLanguage || null,\n    correlationId,\n    sourceMessageId,\n  };\n  for (const key of configKeys) delete json[key];\n  return { ...item, json };\n});"
