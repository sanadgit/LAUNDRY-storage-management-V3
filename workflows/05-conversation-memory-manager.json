{
  "name": "InOut AI - 05 Conversation Memory Manager",
  "nodes": [
    {
      "id": "contract-note",
      "name": "Input Output Contract",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -720,
        -300
      ],
      "parameters": {
        "content": "## Conversation Memory Manager\n\nLoads or creates compact conversation memory for the AI customer-service agent.\n\nInput: Customer identity, normalized phone, latest message, language, intent, and active object IDs.\nOutput: { memory: { customerId, conversationId, currentOrderId, currentPickupId, currentDeliveryId, currentComplaintId, branchId, language, currentIntent, humanHandoffStatus, summary, recentMessages } }\n\nShared Input Contract:\n```json\n{\n  \"correlationId\": \"\",\n  \"messageId\": \"\",\n  \"conversationId\": \"\",\n  \"customerId\": \"\",\n  \"customerPhone\": \"\",\n  \"detectedLanguage\": \"\",\n  \"intent\": \"\",\n  \"payload\": {}\n}\n```\n\nShared Output Contract:\n```json\n{\n  \"success\": true,\n  \"status\": \"SUCCESS\",\n  \"data\": {},\n  \"error\": null,\n  \"meta\": {\n    \"correlationId\": \"\",\n    \"workflow\": \"\",\n    \"durationMs\": 0\n  }\n}\n```\n\nRequired fields:\n- correlationId\n- workflowExecutionId\n- idempotencyKey when writing\n\nRules:\n- Use short-term state, structured customer context, and a concise summary instead of full transcript replay.\n- Do not store API keys, payment-sensitive data, or unnecessary personal data.\n- If context is too large, summarize old messages through the service API before returning memory."
      }
    },
    {
      "id": "workflow-input",
      "name": "Workflow Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -680,
        20
      ],
      "parameters": {}
    },
    {
      "id": "find-active-conversation",
      "name": "Find Active Conversation",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -400,
        20
      ],
      "parameters": {
        "method": "GET",
        "url": "={{($vars.SERVICE_API_BASE_URL || 'MISSING_SERVICE_API_BASE_URL').replace(/\\/$/, '').replace(/\\/api\\/v1$/i, '') + '/api/v1/ai/conversations/active?customerId=' + encodeURIComponent($json.customerId || $json.customer?.id || $json.identity?.customer?.id || '') + '&phone=' + encodeURIComponent($json.normalizedPhone || $json.normalized_phone || $json.customer_phone || $json.identity?.normalizedPhone || '')'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + ($vars.N8N_API_KEY || '')}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Correlation-Id",
              "value": "={{$json.correlationId || $json.correlation_id}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{($json.idempotencyKey || $json.idempotency_key || $json.wamid || $json.correlationId || $json.correlation_id || $execution.id)}}"
            }
          ]
        },
        "sendBody": false,
        "contentType": "json",
        "jsonBody": "={{$json}}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      }
    },
    {
      "id": "conversation-exists",
      "name": "Conversation Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -140,
        20
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-conversation",
              "leftValue": "={{$json.statusCode >= 200 && $json.statusCode < 300 && Boolean($json.body?.data?.conversationId || $json.body?.data?.conversation_id)}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
