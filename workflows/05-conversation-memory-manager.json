    {
      "id": "return-memory-context",
      "name": "Return Memory Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        20
      ],
      "parameters": {
        "jsCode": "return $input.all().map((item) => {\n  const json = { ...(item.json || {}) };\n  const data = ((json.body || {}).data) || {};\n  const input = $('Workflow Input').first().json || {};\n  const conversationId = data.conversationId || data.conversation_id || json.conversationId || input.conversationId || '';\n  const correlationId = json.correlationId || json.correlation_id || input.correlationId || input.correlation_id || '';\n  const memory = {\n    customerId: data.customerId || data.customer_id || input.customerId || null,\n    conversationId: conversationId || null,\n    currentOrderId: data.currentOrderId || data.current_order_id || input.currentOrderId || null,\n    currentPickupId: data.currentPickupId || data.current_pickup_id || input.currentPickupId || null,\n    currentDeliveryId: data.currentDeliveryId || data.current_delivery_id || input.currentDeliveryId || null,\n    currentComplaintId: data.currentComplaintId || data.current_complaint_id || input.currentComplaintId || null,\n    branchId: data.branchId || data.branch_id || input.branchId || null,\n    language: data.language || input.detectedLanguage || input.language || null,\n    currentIntent: data.currentIntent || data.current_intent || input.intent || null,\n    humanHandoffStatus: data.humanHandoffStatus || data.human_handoff_status || null,\n    summary: data.summary || '',\n    recentMessages: Array.isArray(data.recentMessages) ? data.recentMessages : [],\n  };\n\n  return {\n    ...item,\n    json: {\n      ...json,\n      memory,\n      conversationId,\n      correlationId,\n      success: true,\n      status: 'SUCCESS',\n    },\n  };\n});"
      }
    },
