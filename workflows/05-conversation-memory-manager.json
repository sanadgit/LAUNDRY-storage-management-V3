        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { provider: 'whatsapp', customerId: $json.customerId || $json.customer?.id || $json.identity?.customer?.id || null, normalizedPhone: $json.normalizedPhone || $json.normalized_phone || $json.customer_phone || $json.identity?.normalizedPhone || null, language: $json.language || $json.detectedLanguage || null, correlationId: $json.correlationId || $json.correlation_id, sourceMessageId: $json.wamid || $json.messageId || $json.normalizedMessage?.wamid || null } }}",
        "options": {
