{
  "name": "InOut AI - 02 Message Idempotency Check",
  "nodes": [
    {
      "id": "contract-note",
      "name": "Input Output Contract",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -720,
        -300
      ],
      "parameters": {
        "content": "## Message Idempotency Check\n\nChecks and reserves a WhatsApp message ID before downstream customer actions run.\n\nInput: Normalized message with messageId, wamid, or normalizedMessage.wamid.\nOutput: { duplicate: false, lockAcquired: true, messageId: \"\" }\n\nShared Input Contract:\n```json\n{\n  \"correlationId\": \"\",\n  \"messageId\": \"\",\n  \"conversationId\": \"\",\n  \"customerId\": \"\",\n  \"customerPhone\": \"\",\n  \"detectedLanguage\": \"\",\n  \"intent\": \"\",\n  \"payload\": {}\n}\n```\n\nShared Output Contract:\n```json\n{\n  \"success\": true,\n  \"status\": \"SUCCESS\",\n  \"data\": {},\n  \"error\": null,\n  \"meta\": {\n    \"correlationId\": \"\",\n    \"workflow\": \"\",\n    \"durationMs\": 0\n  }\n}\n```\n\nRequired fields:\n- correlationId\n- workflowExecutionId\n- idempotencyKey when writing\n\nRules:\n- Use GET /api/v1/webhook-events/:messageId before creating side effects.\n- Use POST /api/v1/webhook-events/lock to reserve a new message.\n- Preserve correlationId and workflowExecutionId.\n- Do not send WhatsApp replies from this workflow."
      }
    },
    {
      "id": "workflow-input",
      "name": "Workflow Input",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1,
      "position": [
        -680,
        20
      ],
      "parameters": {}
    },
    {
      "id": "extract-whatsapp-message-id",
      "name": "Extract WhatsApp Message ID",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -380,
        20
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "messageId",
              "name": "messageId",
              "type": "string",
              "value": "={{String($json.messageId || $json.wamid || $json.normalizedMessage?.messageId || $json.normalizedMessage?.wamid || \"\")}}"
            },
            {
              "id": "correlationId",
              "name": "correlationId",
              "type": "string",
              "value": "={{$json.correlationId || $json.normalizedMessage?.correlationId || 'corr_' + Date.now() + '_' + ($execution.id || 'n8n')}}"
            },
            {
              "id": "workflowExecutionId",
              "name": "workflowExecutionId",
              "type": "string",
              "value": "={{String($execution.id || \"\")}}"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {
          "dotNotation": false
        }
      }
    },
    {
      "id": "find-processed-event",
      "name": "Find Processed Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -120,
        20
      ],
      "parameters": {
        "method": "GET",
        "url": "={{($vars.SERVICE_API_BASE_URL || 'MISSING_SERVICE_API_BASE_URL').replace(/\\/$/, '').replace(/\\/api\\/v1$/i, '') + '/api/v1/webhook-events/' + encodeURIComponent($json.messageId || 'missing') + ''}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + ($vars.N8N_API_KEY || '')}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Correlation-Id",
              "value": "={{$json.correlationId || $json.correlation_id}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{($json.idempotencyKey || $json.idempotency_key || $json.wamid || $json.correlationId || $json.correlation_id || $execution.id)}}"
            }
          ]
        },
        "sendBody": false,
        "contentType": "json",
        "jsonBody": "={{$json}}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      }
    },
    {
      "id": "message-already-exists",
      "name": "Message Already Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        140,
        20
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "existing-event",
              "leftValue": "={{$json.statusCode === 200 && Boolean($json.body?.ok !== false && ($json.body?.data || $json.body?.event || $json.body?.messageId))}}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "return-duplicate-result",
      "name": "Return Duplicate Result",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        400,
        -100
      ],
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "duplicate",
              "name": "duplicate",
              "type": "boolean",
              "value": true
            },
            {
              "id": "lockAcquired",
              "name": "lockAcquired",
              "type": "boolean",
              "value": false
            },
            {
              "id": "messageId",
              "name": "messageId",
              "type": "string",
              "value": "={{$(\"Extract WhatsApp Message ID\").first().json.messageId}}"
            },
            {
              "id": "correlationId",
              "name": "correlationId",
              "type": "string",
              "value": "={{$(\"Extract WhatsApp Message ID\").first().json.correlationId}}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {
          "dotNotation": false
        }
      }
    },
    {
      "id": "register-processing-lock",
      "name": "Register Processing Lock",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        400,
        120
      ],
      "parameters": {
        "method": "POST",
        "url": "={{($vars.SERVICE_API_BASE_URL || 'MISSING_SERVICE_API_BASE_URL').replace(/\\/$/, '').replace(/\\/api\\/v1$/i, '') + '/api/v1/webhook-events/lock'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + ($vars.N8N_API_KEY || '')}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Correlation-Id",
              "value": "={{$json.correlationId || $json.correlation_id}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{($json.idempotencyKey || $json.idempotency_key || $json.wamid || $json.correlationId || $json.correlation_id || $execution.id)}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { provider: 'whatsapp', messageId: $('Extract WhatsApp Message ID').first().json.messageId, correlationId: $('Extract WhatsApp Message ID').first().json.correlationId, workflowExecutionId: $('Extract WhatsApp Message ID').first().json.workflowExecutionId, receivedAt: new Date().toISOString() } }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      }
    }
  ],
  "connections": {
    "Workflow Input": {
      "main": [
        [
          {
            "node": "Extract WhatsApp Message ID",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract WhatsApp Message ID": {
      "main": [
        [
          {
            "node": "Find Processed Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Find Processed Event": {
      "main": [
        [
          {
            "node": "Message Already Exists?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Message Already Exists?": {
      "main": [
        [
          {
            "node": "Return Duplicate Result",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Register Processing Lock",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "timezone": "Asia/Dubai",
    "executionOrder": "v1"
  },
  "versionId": "inout-ai-02-message-idempotency-check",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "pinData": {},
  "tags": [
    {
      "name": "inout-ai"
    },
    {
      "name": "idempotency"
    }
  ]
}
