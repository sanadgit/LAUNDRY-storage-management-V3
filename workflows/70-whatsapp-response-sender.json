      ],
      "parameters": {
        "mode": "rules",
        "rules": {
          "values": [
            {
              "conditions": {
                "conditions": [
                  {
                    "leftValue": "={{Boolean($json.templateName || $json.template?.name || $json.customerServiceWindowOpen === false || $json.requiresTemplate)}}",
