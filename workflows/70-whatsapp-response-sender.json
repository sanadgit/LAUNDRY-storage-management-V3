    {
      "id": "save-notification-status",
      "name": "Save Notification Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        580,
        20
      ],
      "parameters": {
        "method": "POST",
        "url": "={{($node[\"Workflow Config\"].json[\"SERVICE_API_BASE_URL\"] || 'MISSING_SERVICE_API_BASE_URL').replace(/\\/$/, '').replace(/\\/api\\/v1$/i, '') + '/api/v1/notifications/whatsapp'}}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{'Bearer ' + ($node[\"Workflow Config\"].json[\"N8N_API_KEY\"] || '')}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "X-Correlation-Id",
              "value": "={{$json.correlationId || $json.correlation_id}}"
            },
            {
              "name": "Idempotency-Key",
              "value": "={{($json.idempotencyKey || $json.idempotency_key || $json.wamid || $json.correlationId || $json.correlation_id || $execution.id)}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "jsonBody": "={{ { direction: 'outbound', recipientType: 'customer', to: (($items('Prepare Text Message', 0, 0)[0] || $items('Prepare Template Message', 0, 0)[0] || {}).json || {}).to, provider: 'whatsapp_cloud_api', messageType: (($items('Prepare Text Message', 0, 0)[0] || $items('Prepare Template Message', 0, 0)[0] || {}).json || {}).messageType, providerMessageId: (($json.messages && $json.messages[0] && $json.messages[0].id) || $json.messageId || ''), status: (($json.messages && $json.messages[0] && $json.messages[0].id) || $json.messageId) ? 'sent' : 'failed', rateLimited: $json.statusCode === 429 || ($json.error && $json.error.code === 429), idempotencyKey: (($items('Prepare Text Message', 0, 0)[0] || $items('Prepare Template Message', 0, 0)[0] || {}).json || {}).idempotencyKey, conversationId: $('Workflow Input').first().json.conversationId || $('Workflow Input').first().json.conversation_id || null, correlationId: (($items('Prepare Text Message', 0, 0)[0] || $items('Prepare Template Message', 0, 0)[0] || {}).json || {}).correlationId } }}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      }
    },
    {
      "id": "return-provider-result",
      "name": "Return Provider Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        840,
        20
      ],
      "parameters": {
        "jsCode": "const input = $('Workflow Input').first().json;\nconst preparedText = (() => { try { return $('Prepare Text Message').first().json; } catch { return null; } })();\nconst preparedTemplate = (() => { try { return $('Prepare Template Message').first().json; } catch { return null; } })();\nconst prepared = preparedText || preparedTemplate || input;\nconst body = $json.body || {};\nconst data = body.data || {};\nconst providerMessageId =\n  ($json.messages && $json.messages[0] && $json.messages[0].id) ||\n  $json.messageId ||\n  $json.id ||\n  data.providerMessageId ||\n  (data.providerResponse && data.providerResponse.messages && data.providerResponse.messages[0] && data.providerResponse.messages[0].id) ||\n  '';\nconst statusCode = Number($json.statusCode || 200);\nconst success = Boolean(providerMessageId) || (statusCode >= 200 && statusCode < 300 && body.ok !== false && !$json.error);\nreturn [{\n  json: {\n    success,\n    providerMessageId,\n    notificationStatus: success ? 'sent' : 'failed',\n    to: prepared.to || '',\n    messageType: prepared.messageType || input.messageType || 'text',\n    correlationId: prepared.correlationId || input.correlationId || input.correlation_id || '',\n    meta: {\n      workflow: 'whatsapp.response-sender',\n      logged: false,\n      logSkippedReason: 'Avoid duplicate send: /api/v1/notifications/whatsapp currently sends WhatsApp instead of log-only.',\n    },\n    providerResponse: $json,\n  },\n}];"
      }
    },
