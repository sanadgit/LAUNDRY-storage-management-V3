              "name": "missingFields",
              "type": "array",
              "value": "={{[\"customerId\",\"phone\",\"address\",\"area\",\"location\",\"preferredDate\",\"preferredTimeWindow\",\"garmentCategory\",\"specialInstructions\"].filter(field => field === \"location\" ? !($json.googleMapsLink || $json.coordinates?.lat || $json.coordinates?.latitude) : !$json[field])}}"
            },
