<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:id="@+id/payment_bottom_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:weightSum="110">
    <RelativeLayout
        android:gravity="end"
        android:background="@drawable/color_rounded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/backButton"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="5dp"
            android:focusable="true"
            android:clickable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="25dp">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="20dp"
                android:layout_height="20dp"
                app:srcCompat="@drawable/ic_backbutton"
                app:tint="@color/white"/>
        </LinearLayout>
        <TextView
            android:textSize="18sp"
            android:textColor="@color/white"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Printer type"
            android:textAlignment="center"/>
    </RelativeLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"/>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="100">
        <RadioGroup
            android:orientation="vertical"
            android:id="@+id/printer_radio"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layoutDirection="rtl"
            android:layout_marginStart="25dp"
            android:layout_marginEnd="25dp">
            <RadioButton
                android:textSize="17sp"
                android:id="@+id/bluetooth"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="Bluetooth printer"
                android:layout_weight="1"
                android:textAlignment="textStart"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:buttonTint="@android:color/black"/>
            <RadioButton
                android:textSize="17sp"
                android:id="@+id/wifi"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp"
                android:text="Network printer"
                android:layout_weight="1"
                android:textAlignment="textStart"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:buttonTint="@android:color/black"/>
        </RadioGroup>
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="3"/>
</LinearLayout>
