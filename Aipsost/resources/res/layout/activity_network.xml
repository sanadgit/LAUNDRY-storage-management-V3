<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:weightSum="100">
        <LinearLayout
            android:id="@+id/heading_layout"
            android:background="@color/colorPrimary"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="10"
            android:animateLayoutChanges="true">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:weightSum="10">
                <LinearLayout
                    android:gravity="start|center_vertical"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2.5">
                    <ImageView
                        android:id="@+id/close"
                        android:background="@drawable/ripple"
                        android:padding="10dp"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:backgroundTint="@color/darkblue"
                        app:srcCompat="@drawable/ic_back"
                        app:tint="@color/white"/>
                </LinearLayout>
                <TextView
                    android:textSize="18sp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Network printer settings"
                    android:layout_weight="6"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="80">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/black"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="10dp"
                    android:text="IP address of printer"
                    android:layout_marginStart="10dp"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:weightSum="7"
                    android:layoutDirection="ltr">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.2"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <EditText
                            android:textSize="13sp"
                            android:gravity="center"
                            android:id="@+id/ip1"
                            android:background="@drawable/ip_border"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="192"
                            android:maxLength="3"
                            android:inputType="number"
                            android:imeOptions="actionNext"
                            android:nextFocusForward="@+id/ip2"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="20sp"
                        android:gravity="bottom|center_horizontal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="."
                        android:layout_weight="0.2"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <EditText
                            android:textSize="13sp"
                            android:gravity="center"
                            android:id="@+id/ip2"
                            android:background="@drawable/ip_border"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="168"
                            android:maxLength="3"
                            android:inputType="number"
                            android:imeOptions="actionNext"
                            android:nextFocusForward="@+id/ip3"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="20sp"
                        android:gravity="bottom|center_horizontal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="."
                        android:layout_weight="0.2"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <EditText
                            android:textSize="13sp"
                            android:gravity="center"
                            android:id="@+id/ip3"
                            android:background="@drawable/ip_border"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="1"
                            android:maxLength="3"
                            android:inputType="number"
                            android:imeOptions="actionNext"
                            android:nextFocusForward="@+id/ip4"/>
                    </LinearLayout>
                    <TextView
                        android:textSize="20sp"
                        android:gravity="bottom|center_horizontal"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:text="."
                        android:layout_weight="0.2"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1">
                        <EditText
                            android:textSize="13sp"
                            android:gravity="center"
                            android:id="@+id/ip4"
                            android:background="@drawable/ip_border"
                            android:padding="5dp"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="1"
                            android:maxLength="3"
                            android:inputType="number"
                            android:imeOptions="actionDone"
                            android:nextFocusForward="@+id/port"/>
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="0.2"/>
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"/>
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="25dp">
                    <LinearLayout
                        android:background="#f3f3f3"
                        android:layout_width="match_parent"
                        android:layout_height="10dp"/>
                </LinearLayout>
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="10dp"
                        android:text="Port"
                        android:layout_marginStart="10dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:weightSum="7">
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp">
                            <EditText
                                android:textSize="13sp"
                                android:gravity="center"
                                android:id="@+id/port"
                                android:background="@drawable/ip_border"
                                android:padding="5dp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="9100"
                                android:maxLength="4"
                                android:inputType="number"
                                android:imeOptions="actionDone"/>
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="20dp"
                android:weightSum="2">
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <Button
                        android:textColor="@color/white"
                        android:id="@+id/disconnectButton"
                        android:background="@drawable/button_state"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Disconnect"
                        android:layout_marginStart="40dp"
                        android:layout_marginEnd="40dp"/>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">
                    <Button
                        android:textColor="@color/white"
                        android:id="@+id/connectButton"
                        android:background="@drawable/button_state"
                        android:focusable="true"
                        android:clickable="true"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Connect"
                        android:layout_marginStart="40dp"
                        android:layout_marginEnd="40dp"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginBottom="10dp"
            android:weightSum="2"
            android:layout_weight="10">
            <Button
                android:textColor="@color/white"
                android:id="@+id/testprint"
                android:background="@drawable/button_state"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Test Connection"
                android:layout_weight="1"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="5dp"/>
            <Button
                android:textColor="@color/white"
                android:id="@+id/save"
                android:background="@drawable/normal_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Close"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="15dp"/>
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
