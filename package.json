{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "cross-env NODE_ENV=production tsx server.ts",
    "start:prod": "cross-env NODE_ENV=production tsx server.ts",
    "build": "npm run build:hub && npm run build:customer",
    "build:hub": "vite build --base /smart-storage-hub/ --outDir dist-smart-storage-hub",
    "build:customer": "npm --prefix apps/customer-site run build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "migrate:supabase": "tsx scripts/migrate-sqlite-to-supabase.ts",
    "migrate:supabase:node": "node scripts/migrate-sqlite-to-supabase.mjs",
    "reset:supabase:from-sqlite": "node scripts/reset-supabase-from-sqlite.mjs",
    "dedupe:supabase": "tsx scripts/dedupe-supabase-data.ts",
    "migrate:postgres": "tsx scripts/migrate-sqlite-to-postgres.ts",
    "migrate:ai": "tsx scripts/apply-ai-migrations.ts",
    "test:ai": "tsx --test tests/ai/*.test.ts",
    "validate:n8n-workflows": "node scripts/validate-n8n-workflows.cjs",
    "validate:n8n-strict": "node scripts/validate-n8n-workflows.js",
    "validate:n8n-mvp": "node scripts/validate-n8n-mvp-package.cjs",
    "validate:n8n-pickup-driver": "node scripts/validate-n8n-pickup-driver-package.cjs",
    "validate:n8n-complaint-handoff": "node scripts/validate-n8n-complaint-handoff-package.cjs",
    "audit:n8n-live": "node scripts/audit-n8n-live-integration-readiness.cjs",
    "generate:n8n-workflows": "node scripts/generate-required-n8n-workflows.cjs"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/better-sqlite3": "^7.6.13",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.0.4",
    "@zxing/browser": "^0.1.5",
    "axios": "^1.14.0",
    "better-sqlite3": "^12.8.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.16.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.14.0",
    "tailwind-merge": "^3.5.0",
    "three": "^0.170.0",
    "xlsx": "^0.18.5",
    "vite": "^6.2.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.15.5",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
