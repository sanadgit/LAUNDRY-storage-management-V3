    {
      "parameters": {
        "jsCode": "const previous = $('Normalize Receipt Submission').first().json;\nconst receiptUrl = $json.url || $json.webViewLink || $json.receipt_url || 'uploaded';\nconst money = (value) => Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst message = `✅ تم استلام إيصال الإيداع\\n🏪 الفرع: ${previous.branch_name}\\n👤 المدير: ${previous.manager_name}\\n💰 المبلغ: ${money(previous.deposit_amount)} AED\\n📎 تم حفظ الإيصال بنجاح.\\nDeposit ID: ${previous.deposit_id}`;\nreturn [{ json: { ...previous, receipt_url: receiptUrl, whatsapp_to: 'REPLACE_MANAGEMENT_GROUP_ID', message } }];"
