{
  "name": "Laundry Branch Financial Reports Automation - No Env",
  "nodes": [
    {
      "parameters": {
        "content": "## 1. Daily Financial Report\nRuns every day at 10:30 PM Dubai time.\nFetches POS counter cash report through Smart Storage Hub API, builds Arabic WhatsApp message, sends to management group."
      },
      "id": "note-daily",
      "name": "Daily Financial Report",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -920,
        -360
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 22 * * *"
            }
          ]
        }
      },
      "id": "daily-schedule",
      "name": "Daily Schedule 10:30 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -900,
        -180
      ]
    },
    {
      "parameters": {
        "jsCode": "const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Dubai', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(new Date());\nconst get = (type) => parts.find((part) => part.type === type)?.value;\nconst date = `${get('year')}-${get('month')}-${get('day')}`;\nreturn [{ json: { report_type: 'daily', from_date: date, to_date: date, period_label: date } }];"
      },
      "id": "daily-range",
      "name": "Daily Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        -180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3002/api/login",
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "username",
              "value": "sanad"
            },
            {
              "name": "password",
              "value": "REPLACE_SMART_HUB_PASSWORD"
            }
          ]
        },
        "options": {}
      },
      "id": "daily-login",
      "name": "Smart Hub Login - Daily",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -420,
        -180
      ],
      "notes": "Edit URL/username/password here if your Smart Storage Hub is not reachable at host.docker.internal:3002. This no-env version uses direct values only."
    },
    {
      "parameters": {
        "jsCode": "const range = $('Daily Date Range').first().json;\nreturn [{ json: { ...range, token: $json.token } }];"
      },
      "id": "daily-attach-token",
      "name": "Attach Daily Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -180,
        -180
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3002/api/pos/report/counter-cash",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$json.token}}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "from_date",
              "value": "={{$json.from_date}}"
            },
            {
              "name": "from_time",
              "value": "12:00 AM"
            },
            {
              "name": "to_date",
              "value": "={{$json.to_date}}"
            },
            {
              "name": "to_time",
              "value": "11:59 PM"
            }
          ]
        },
        "options": {}
      },
      "id": "daily-fetch-report",
      "name": "Fetch POS Daily Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        60,
        -180
      ]
    },
    {
      "parameters": {
        "jsCode": "const summary = $json.summary || {};\nconst money = (value) => Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst date = summary.date_range || $('Daily Date Range').first().json.period_label;\nconst netCash = Number(summary.cash_receipt || 0) - Number(summary.cash_expense_total || 0);\nconst cardExpense = Number(summary.credit_card_expense_total || 0);\nconst alerts = [];\nif (Number(summary.expense_total || 0) <= 0) alerts.push('لا توجد مصروفات مسجلة في التقرير.');\nif (netCash < 0) alerts.push('تنبيه: صافي الكاش سالب، يرجى المراجعة.');\nif (cardExpense > 0) alerts.push(`يوجد مصروفات بطاقة: ${money(cardExpense)} AED`);\nconst message = `📊 التقرير المالي اليومي\\n📅 التاريخ: ${date}\\n\\n🏪 الفرع: ${summary.branch || 'غير محدد'}\\n💰 إجمالي المبيعات: ${money(summary.total_income)} AED\\n💵 الكاش: ${money(summary.cash_receipt)} AED\\n💳 البطاقة: ${money(summary.card_receipt)} AED\\n📉 مصروفات الكاش: ${money(summary.cash_expense_total)} AED\\n💳 مصروفات البطاقة: ${money(summary.credit_card_expense_total)} AED\\n📉 إجمالي المصروفات: ${money(summary.expense_total)} AED\\n✅ صافي الكاش الموجود: ${money(netCash)} AED\\n🧾 عدد الطلبات: ${Number(summary.total_invoice || 0)}\\n\\n${alerts.length ? '⚠️ ملاحظات:\\n- ' + alerts.join('\\n- ') : '✅ لا توجد ملاحظات مالية حرجة.'}`;\nreturn [{ json: { report_type: 'daily', branch_name: summary.branch, whatsapp_to: 'REPLACE_MANAGEMENT_GROUP_ID', message, summary } }];"
      },
      "id": "daily-build-message",
      "name": "Build Daily WhatsApp Message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        -180
      ]
    },
    {
      "parameters": {
        "authentication": "genericCredentialType",
        "genericAuthType": "httpBearerAuth",
        "method": "POST",
        "url": "https://graph.facebook.com/v20.0/REPLACE_PHONE_NUMBER_ID/messages",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { to: $json.whatsapp_to, type: 'text', text: { body: $json.message } } }}",
        "options": {}
      },
      "id": "daily-send-whatsapp",
      "name": "Send Daily WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        540,
        -180
      ],
      "credentials": {
        "httpBearerAuth": {
          "id": "REPLACE_WITH_WHATSAPP_BEARER_CREDENTIAL_ID",
          "name": "WhatsApp API Bearer Token"
        }
      },
      "notes": "Replace REPLACE_PHONE_NUMBER_ID in URL, then attach the WhatsApp API Bearer Token credential."
    },
    {
      "parameters": {
        "content": "## 2. Weekly Cash Deposit Report\nRuns every Sunday at 10:45 PM Dubai time.\nCalculates weekly cash deposit amount and sends one message to branch manager plus copy to management."
      },
      "id": "note-weekly",
      "name": "Weekly Cash Deposit Report",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -920,
        80
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "45 22 * * 0"
            }
          ]
        }
      },
      "id": "weekly-schedule",
      "name": "Weekly Schedule Sunday 10:45 PM",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -900,
        260
      ]
    },
    {
      "parameters": {
        "jsCode": "const pad = (n) => String(n).padStart(2, '0');\nconst format = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;\nconst dubaiNow = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Dubai' }));\nconst end = new Date(dubaiNow);\nconst start = new Date(dubaiNow);\nstart.setDate(end.getDate() - 6);\nreturn [{ json: { report_type: 'weekly', from_date: format(start), to_date: format(end), period_label: `${format(start)} إلى ${format(end)}` } }];"
      },
      "id": "weekly-range",
      "name": "Weekly Date Range",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        260
      ]
    },
