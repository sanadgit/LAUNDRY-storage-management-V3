    {
      "parameters": {
        "jsCode": "const summary = $json.summary || {};\nconst range = $('Weekly Date Range').first().json;\nconst money = (value) => Number(value || 0).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });\nconst depositAmount = Number(summary.cash_receipt || 0) - Number(summary.cash_expense_total || 0);\nconst branchName = summary.branch || 'AL FALAH';\nconst managerName = 'Branch Manager';\nconst managerWhatsapp = 'REPLACE_BRANCH_MANAGER_WHATSAPP';\nconst depositId = `${branchName.replace(/\\s+/g, '_')}_${range.from_date}_${range.to_date}`;\nconst managerMessage = `📌 تقرير الإيداع الأسبوعي\\n🏪 الفرع: ${branchName}\\n📅 الفترة: ${range.period_label}\\n\\n💵 إجمالي الكاش: ${money(summary.cash_receipt)} AED\\n📉 إجمالي مصروفات الكاش: ${money(summary.cash_expense_total)} AED\\n🏦 المبلغ المطلوب إيداعه: ${money(depositAmount)} AED\\n\\nيرجى إيداع مبلغ ${money(depositAmount)} AED في الحساب البنكي، ثم إرسال صورة إيصال الإيداع في هذا القروب/الواتساب.\\n\\nDeposit ID: ${depositId}`;\nconst adminMessage = `📌 نسخة الإدارة - تقرير الإيداع الأسبوعي\\n🏪 الفرع: ${branchName}\\n👤 المدير: ${managerName}\\n📅 الفترة: ${range.period_label}\\n💵 الكاش: ${money(summary.cash_receipt)} AED\\n📉 مصروفات الكاش: ${money(summary.cash_expense_total)} AED\\n🏦 المطلوب إيداعه: ${money(depositAmount)} AED\\nDeposit ID: ${depositId}`;\nreturn [{ json: { report_type: 'weekly_deposit', deposit_id: depositId, branch_name: branchName, manager_name: managerName, manager_whatsapp: managerWhatsapp, admin_whatsapp: 'REPLACE_MANAGEMENT_GROUP_ID', deposit_amount: depositAmount, manager_message: managerMessage, admin_message: adminMessage, summary } }];"
      },
      "id": "weekly-build-message",
      "name": "Build Weekly Deposit Messages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        300,
        260
      ]
    },
    {
