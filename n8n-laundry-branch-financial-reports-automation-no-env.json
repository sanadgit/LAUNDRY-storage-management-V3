        "jsCode": "const pad = (n) => String(n).padStart(2, '0');\nconst format = (date) => `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;\nconst now = new Date(new Date().toLocaleString('en-US', { timeZone: 'Asia/Dubai' }));\nconst firstThisMonth = new Date(now.getFullYear(), now.getMonth(), 1);\nconst lastPrevMonth = new Date(firstThisMonth);\nlastPrevMonth.setDate(0);\nconst firstPrevMonth = new Date(lastPrevMonth.getFullYear(), lastPrevMonth.getMonth(), 1);\nconst monthLabel = `${firstPrevMonth.getFullYear()}-${pad(firstPrevMonth.getMonth() + 1)}`;\nreturn [{ json: { report_type: 'monthly', from_date: format(firstPrevMonth), to_date: format(lastPrevMonth), period_label: monthLabel } }];"
